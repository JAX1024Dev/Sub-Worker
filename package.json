{
  "name": "sub-worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Convert 3x-ui subscriptions into platform-specific sing-box configurations.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --passWithNoTests",
    "test:config": "pnpm fixtures:check && node scripts/validate-generated-configs.mjs && node --import tsx scripts/validate-published-configs.ts",
    "test:rulesets": "tsx scripts/verify-rule-sets.ts && pnpm rules:check:ios-routes",
    "rules:generate:ios-routes": "tsx scripts/generate-ios-route-excludes.ts",
    "rules:check:ios-routes": "tsx scripts/generate-ios-route-excludes.ts --check",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:config": "tsx scripts/check-live-subscription.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "cf:typegen": "wrangler types",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "config:validate": "tsx scripts/validate-config-sources.ts",
    "config:build": "tsx scripts/build-config-bundles.ts",
    "config:channels:check": "tsx scripts/check-channel-manifests.ts",
    "config:diff": "tsx scripts/diff-config-bundles.ts",
    "config:export": "tsx scripts/export-live-config.ts",
    "config:publish:staging": "tsx scripts/publish-staging-config.ts",
    "config:promote:production": "tsx scripts/promote-production-config.ts",
    "build": "pnpm typecheck && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm config:diff && pnpm config:channels:check && pnpm test:config && pnpm build",
    "release:check": "pnpm check && pnpm test:rulesets && pnpm test:e2e && pnpm test:e2e:config && pnpm audit --audit-level high",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test:macos:dual-stack": "node scripts/test-macos-dual-stack.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.6",
    "@types/node": "26.5.0",
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "tsx": "4.23.13",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  }
}
