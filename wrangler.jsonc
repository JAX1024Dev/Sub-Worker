{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "vars": {
    "IOS_ROUTING_MODE": "native-bypass",
  },
  "env": {
    "staging": {
      "name": "sub-worker-staging",
      "vars": {
        "IOS_ROUTING_MODE": "tun-dual-stack",
      },
    },
    "production": {
      "name": "sub-worker-production",
      "vars": {
        "IOS_ROUTING_MODE": "tun-dual-stack",
      },
    },
  },
}
