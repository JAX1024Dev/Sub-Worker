{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://subworker.jax1024.com/schema/manifest.schema.json",
  "title": "Sub-Worker sing-box channel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "channel", "profiles"],
  "properties": {
    "schema_version": { "const": 1 },
    "channel": { "enum": ["staging", "production"] },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["ios", "macos", "android", "windows", "linux"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_url", "sha256"],
        "properties": {
          "bundle_url": {
            "type": "string",
            "pattern": "^https://raw\\.githubusercontent\\.com/JAX1024Dev/Sub-Worker/[0-9a-f]{40}/example/sing-box/published/(ios|macos|android|windows|linux)\\.bundle\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
