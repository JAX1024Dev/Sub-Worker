{
  "servers": [
    {
      "type": "https",
      "tag": "dns-cn",
      "server": "223.5.5.5",
      "server_port": 443,
      "path": "/dns-query",
      "tls": {
        "enabled": true,
        "server_name": "dns.alidns.com"
      }
    },
    {
      "type": "https",
      "tag": "dns-global",
      "server": "1.1.1.1",
      "server_port": 443,
      "path": "/dns-query",
      "tls": {
        "enabled": true,
        "server_name": "cloudflare-dns.com"
      },
      "detour": "🚀 节点选择"
    }
  ],
  "rules": [
    {
      "rule_set": "apple",
      "action": "route",
      "server": "dns-global"
    },
    {
      "rule_set": "microsoft",
      "action": "route",
      "server": "dns-cn"
    },
    {
      "query_type": ["AAAA"],
      "action": "reject",
      "no_drop": true
    },
    {
      "rule_set": "geosite-cn",
      "action": "route",
      "server": "dns-cn"
    },
    {
      "action": "route",
      "server": "dns-global"
    }
  ],
  "final": "dns-global",
  "strategy": "ipv4_only",
  "disable_cache": false,
  "optimistic": false,
  "timeout": "5s"
}
